{
  "version": 2,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/index?path=health"
    },
    {
      "source": "/api/cron",
      "destination": "/api/index?path=cron"
    },
    {
      "source": "/api/cron/(.*)",
      "destination": "/api/index?path=cron/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?path=$1"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
